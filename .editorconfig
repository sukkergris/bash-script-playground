root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
indent_size = 4

[*.{conf,nginx}]
indent_size = 2

[*.template]
indent_style = space
indent_size = 2

[*.conf.template]
indent_style = space
indent_size = 2

[*.{sh,bash,zsh}]
indent_size = 4
