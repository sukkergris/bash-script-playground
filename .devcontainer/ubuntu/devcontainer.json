{
    "name": "bash-script-playground-ubuntu",
    "dockerComposeFile": "docker-compose.ubuntu.yml",
    "service": "development",
    "workspaceFolder": "/xyz",
    "mounts": [
        "source=${localEnv:HOME}/.claude,target=/root/.claude,type=bind,consistency=cached",
        "source=${localWorkspaceFolder}/bash-lib,target=/bash-lib,type=bind,consistency=cached"
    ],
    "postCreateCommand": "echo 'export PATH=\"/bash-lib:$PATH\"' >> /root/.bashrc",
    "customizations": {
        "vscode": {
            "extensions": [
                "Anthropic.claude-code",
                "vscodevim.vim",
                "rogalmic.bash-debug",
                "mads-hartmann.bash-ide-vscode",
                "AndreasArvidsson.bashbook",
                "streetsidesoftware.code-spell-checker",
                "openai.chatgpt",
                "streetsidesoftware.code-spell-checker-danish",
                "EditorConfig.EditorConfig",
                "google.geminicodeassist",
                "timonwong.shellcheck",
                "pokey.parse-tree"
            ]
        }
    }
}
